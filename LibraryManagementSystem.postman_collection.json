            "body": { "mode": "raw", "raw": "{\r\n  \"firstName\": \"Alice\",\r\n  \"lastName\": \"Smith\",\r\n  \"email\": \"alice.smith@example.com\",\r\n  \"phone\": \"555-0200\",\r\n  \"address\": \"456 Readers Way\"\r\n}" },
            "url": { "raw": "{{baseUrl}}/members", "host": ["{{baseUrl}}"], "path": ["members"] }
