            "body": { "mode": "raw", "raw": "{\r\n  \"phone\": \"555-9999\",\r\n  \"status\": \"Active\"\r\n}" },
            "url": { "raw": "{{baseUrl}}/members/1", "host": ["{{baseUrl}}"], "path": ["members", "1"] }
          }
        }
      ]
    },
    {
      "name": "5. Categories",
      "item": [
        {
          "name": "Get Categories",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
